# Postgres connection string.
# Vercel: connect Neon or Vercel Postgres. The integration may inject
# DATABASE_URL or POSTGRES_URL. Either name works.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob read/write token.
# Vercel: Storage → Blob → connect the store to this project.
# The token is injected as BLOB_READ_WRITE_TOKEN.
# Locally, leave it unset and signatures are stored in data/signatures/.
BLOB_READ_WRITE_TOKEN=

# Admin password for /admin. Required. Do not commit a real password.
ADMIN_PASSWORD=
